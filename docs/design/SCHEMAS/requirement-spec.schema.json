{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenium.dev/schemas/v1/requirement-spec.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]+$"
          },
          "text": {
            "type": "string"
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^AC-[0-9]+$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "text"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "text",
          "acceptance"
        ]
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "locked_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "version",
    "goals",
    "requirements"
  ],
  "title": "RequirementSpec"
}