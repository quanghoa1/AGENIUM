{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenium.dev/schemas/v1/tools/submit_report.schema.json",
  "title": "submit_report",
  "description": "InProgress → Resolved; ends the run; every acceptance criterion needs a result",
  "x-agenium-role": "Worker",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intent_id": {
      "type": "string",
      "description": "ULID idempotency key",
      "minLength": 1
    },
    "ticket_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]+$",
      "description": "TicketKey, vd. AGN-11"
    },
    "summary": {
      "type": "string",
      "maxLength": 800
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ac_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Met",
              "Partial",
              "NotMet"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "ac_id",
          "status",
          "evidence"
        ]
      },
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ref"
        ]
      }
    },
    "extension": {
      "type": "object",
      "description": "Validate theo report_template"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "follow_ups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "intent_id",
    "ticket_id",
    "summary",
    "acceptance",
    "confidence"
  ]
}