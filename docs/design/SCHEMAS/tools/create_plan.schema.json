{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenium.dev/schemas/v1/tools/create_plan.schema.json",
  "title": "create_plan",
  "description": "Plan v1 from the locked spec; waits for user approval",
  "x-agenium-role": "Lead",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intent_id": {
      "type": "string",
      "description": "ULID idempotency key",
      "minLength": 1
    },
    "spec_version": {
      "type": "integer",
      "minimum": 1
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ]
      },
      "minItems": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PI-[0-9]+$"
          },
          "milestone": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "trace_to": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]+$"
            },
            "minItems": 1
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^AC-[0-9]+$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "text"
              ]
            },
            "minItems": 1
          },
          "role": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^PI-[0-9]+$"
            }
          },
          "estimate": {
            "type": "string",
            "enum": [
              "S",
              "M",
              "L"
            ]
          }
        },
        "required": [
          "id",
          "milestone",
          "title",
          "trace_to",
          "acceptance",
          "role",
          "depends_on",
          "estimate"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "intent_id",
    "spec_version",
    "milestones",
    "items"
  ]
}