{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenium.dev/schemas/v1/tools/propose_role.schema.json",
  "title": "propose_role",
  "description": "Propose a new role; an agent is created only after user approval",
  "x-agenium-role": "Lead",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intent_id": {
      "type": "string",
      "description": "ULID idempotency key",
      "minLength": 1
    },
    "role_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model_hint": {
      "type": "string"
    }
  },
  "required": [
    "intent_id",
    "role_id",
    "title",
    "description"
  ]
}