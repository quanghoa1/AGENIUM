{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenium.dev/schemas/v1/tools/create_aggregate.schema.json",
  "title": "create_aggregate",
  "description": "Create an aggregate ticket (e.g. an attack chain)",
  "x-agenium-role": "Lead",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intent_id": {
      "type": "string",
      "description": "ULID idempotency key",
      "minLength": 1
    },
    "children": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+-[0-9]+$",
        "description": "TicketKey, vd. AGN-11"
      },
      "minItems": 2
    },
    "kind": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "intent_id",
    "children",
    "kind",
    "title"
  ]
}