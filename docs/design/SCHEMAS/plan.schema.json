{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenium.dev/schemas/v1/plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "spec_version": {
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "type": "string"
    },
    "diff": {
      "type": "string"
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ]
      },
      "minItems": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PI-[0-9]+$"
          },
          "milestone": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "trace_to": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]+$"
            },
            "minItems": 1
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^AC-[0-9]+$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "text"
              ]
            },
            "minItems": 1
          },
          "role": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^PI-[0-9]+$"
            }
          },
          "estimate": {
            "type": "string",
            "enum": [
              "S",
              "M",
              "L"
            ]
          }
        },
        "required": [
          "id",
          "milestone",
          "title",
          "trace_to",
          "acceptance",
          "role",
          "depends_on",
          "estimate"
        ]
      },
      "minItems": 1
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "User",
            "Lead"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "version",
    "spec_version",
    "milestones",
    "items"
  ],
  "title": "Plan"
}