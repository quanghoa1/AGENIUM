{
  "$id": "https://agenium.dev/schemas/v1/tools/revise_plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Revise the plan (version+1, with a reason). Use it instead of splitting a ticket: add items, then create tickets for them. Scope changes need user approval.",
  "properties": {
    "base_version": {
      "description": "The plan version this revision is based on.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "acceptance": {
            "items": {
              "additionalProperties": false,
              "description": "One acceptance criterion; ids look like `AC-1` and are referenced by reports and reviews.",
              "properties": {
                "id": {
                  "pattern": "^AC-[0-9]+$",
                  "type": "string"
                },
                "text": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "id",
                "text"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "depends_on": {
            "default": [],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "estimate": {
            "enum": [
              "S",
              "M",
              "L"
            ],
            "type": "string"
          },
          "id": {
            "description": "Plan item id, e.g. PI-1.",
            "pattern": "^PI-[0-9]+$",
            "type": "string"
          },
          "milestone": {
            "type": "string"
          },
          "role": {
            "description": "Role expected to do the work.",
            "type": "string"
          },
          "scope_paths": {
            "default": [],
            "description": "Files/areas the item touches (glob patterns).",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "trace_to": {
            "description": "Requirement ids this item implements, e.g. REQ-2.",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "id",
          "milestone",
          "title",
          "trace_to",
          "acceptance",
          "role",
          "estimate"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "milestones": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "reason": {
      "minLength": 5,
      "type": "string"
    }
  },
  "required": [
    "base_version",
    "reason",
    "milestones",
    "items"
  ],
  "title": "revise_plan",
  "type": "object",
  "x-agenium-role": "Lead"
}
