{
  "$id": "https://agenium.dev/schemas/v1/tools/post_progress.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Post a short progress update on your ticket; does not change its state.",
  "properties": {
    "current": {
      "description": "What you are doing now.",
      "type": "string"
    },
    "eta": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "next": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "percent": {
      "default": null,
      "format": "uint8",
      "maximum": 100,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "step": {
      "default": null,
      "description": "Step k/n, e.g. \"2/5\".",
      "type": [
        "string",
        "null"
      ]
    },
    "ticket_id": {
      "description": "Ticket key, e.g. AGN-11",
      "pattern": "^[A-Z]{1,10}-[1-9][0-9]*$",
      "type": "string"
    }
  },
  "required": [
    "ticket_id",
    "current"
  ],
  "title": "post_progress",
  "type": "object",
  "x-agenium-role": "Worker"
}
